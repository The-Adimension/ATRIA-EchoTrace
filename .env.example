# ATRIA EchoTrace configuration template.
#
# Copy to `.env` and edit. Every value is optional — the application starts and
# the review tier is fully usable with none of them set.
#
#   cp .env.example .env        (macOS/Linux)
#   copy .env.example .env      (Windows)
#
# NEVER commit a filled-in .env; it is git-ignored for that reason.

# --- Hugging Face access -------------------------------------------------------
# Required only for the AI tier. Both the base model and the LoRA adapters are
# gated, so you must first accept their terms while signed in to huggingface.co:
#   https://huggingface.co/google/medgemma-1.5-4b-it
#   https://huggingface.co/The-Adimension/EchoTrace-MedGemma-CAMUS
#   https://huggingface.co/The-Adimension/EchoTrace-MedGemma-EchoNet
#
# Prefer `hf auth login`, which stores the token outside the project directory.
# Set it here only if that is not possible.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Server --------------------------------------------------------------------
# ATRIA_HOST=127.0.0.1
# ATRIA_PORT=8000
# ATRIA_LOG_LEVEL=INFO

# --- Data ----------------------------------------------------------------------
# Directory holding frames/, tracings.json (and optionally metadata.csv).
# ATRIA_DATASET_DIR=./sample-dataset
# Where revisions, exports, uploads and evaluation runs are written.
# ATRIA_OUTPUT_DIR=./outputs

# --- Model ---------------------------------------------------------------------
# ATRIA_BASE_MODEL_ID=google/medgemma-1.5-4b-it
# Which adapter to preselect: base | camus | echonet
# ATRIA_DEFAULT_ADAPTER=camus
# Generation budget. The notebook used 1024.
# ATRIA_MAX_NEW_TOKENS=1024
# Force CPU even when a GPU is present (minutes per frame).
# ATRIA_FORCE_CPU=0
# Load weights only from the local Hugging Face cache; never hit the network.
# ATRIA_OFFLINE=0

# --- Upload limits for clinician-supplied frames --------------------------------
# ATRIA_MAX_UPLOAD_BYTES=16777216
# ATRIA_MAX_UPLOAD_PIXELS=40000000
